# Maintainer: Linus Linhof <tidal-wave@linu.li>
#
# Installs with `cmake --install` alone: the desktop entry and the hicolor
# icons are install rules in CMakeLists.txt, and the tray needs a named theme
# icon. pkgver tracks project() and the source is pinned to the matching tag.
# Build from a checkout with: cd packaging && makepkg -si

pkgname=tidal-wave
pkgver=0.4.0
pkgrel=1
pkgdesc='A native desktop client for Tidal'
arch=('x86_64')
url='https://github.com/immineal/tidal-wave'
license=('GPL-3.0-or-later')

# The .deb's Depends list from CMakeLists.txt under Arch names. gcc-libs is a
# metapackage that pulls far more than libstdc++. No version floors: Arch is
# rolling. The multimedia backend comes through qt6-multimedia-backend.
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  # namcap reads ELF links and misses the next two: Application.cpp dlopens
  # alsa-lib by name, and qt6-svg carries the SVG icon and image plugins.
  'qt6-svg'
  'alsa-lib'
  'avahi'
  'glibc'
  'libgcc'
  'libstdc++'
  # Owns /usr/share/icons/hicolor and its index.theme. Without that index the
  # directories cmake --install writes into are not a theme, so the named-icon
  # lookup the tray depends on finds nothing.
  'hicolor-icon-theme'
)

# qt6-tools is lrelease: without it the configure step only warns and the
# package ships no German catalogue.
makedepends=('cmake' 'ninja' 'git' 'qt6-tools')

# Neither is needed to play music.
optdepends=(
  'ffmpeg: track downloads and Chromecast transcoding'
  'qt6-wayland: run as a native Wayland client instead of through XWayland'
)

# Pinned to the release tag: a -git package would build whatever the default
# branch holds. 'SKIP' is conventional for a VCS source, where the tag is the
# pin.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  # CMAKE_BUILD_TYPE=None is the Arch standard: it keeps makepkg.conf's
  # CXXFLAGS and LDFLAGS. No RPATH options: Arch's Qt is in /usr/lib, an
  # implicit link directory, so CMakeLists.txt adds nothing.
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  # The only install step there is. It brings the binary, the .desktop entry,
  # both hicolor icons and the AppStream metainfo file with it.
  DESTDIR="$pkgdir" cmake --install build
}
