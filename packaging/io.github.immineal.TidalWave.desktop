# The basename is the app id: Flatpak exports only <app-id>.desktop. It must
# match QGuiApplication::setDesktopFileName() and <launchable> in the metainfo
# file, or the Wayland taskbar cannot match the window to this entry.
# Exec= and Icon= are the binary and the installed theme icon name, tidal-wave.
[Desktop Entry]
Type=Application
Version=1.0
Name=Tidal Wave
GenericName=Music Player
Comment=A native desktop client for Tidal
Exec=tidal-wave
Icon=tidal-wave
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;streaming;tidal;audio;hifi;
StartupNotify=true
# The X11 WM_CLASS, which Qt builds from the binary name and
# QCoreApplication::applicationName(). It never follows desktopFileName(), so
# this is the binary name; tests/firstrun/run.sh checks it.
StartupWMClass=tidal-wave
